export interface PlatformAdapter{auth:{login():Promise<unknown>};storage:{getLocal(k:string):Promise<string|null>;setLocal(k:string,v:string):Promise<void>};ui:{toast(m:string):void;confirm(o:unknown):Promise<boolean>};share:{shareRunCard(p:unknown):Promise<void>};ads:{showRewarded(slotId:string):Promise<unknown>};payment?:{purchase(productId:string):Promise<unknown>};telemetry:{platformContext():unknown}}
