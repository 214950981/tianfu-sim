// CORE CONTRACT v0.2
export type RuleContext={rulesVersion:string;contentVersion:string;content:Readonly<ContentRegistry>;commandId:string;actorBindings?:Readonly<Record<string,string>>;actorStatusById?:Readonly<Record<string,'available'|'unavailable'>>};
export type ReduceInput={state:GameState;command:GameCommand;context:RuleContext};
export type ReduceOutput={state:GameState;effects:DomainEffect[];narrativeFacts:Fact[];trace:RuleTrace};
export type RuleTrace={rngDraws:Array<{stream:string;index:number;u32:number}>;director?:unknown[];selector?:unknown[];time?:unknown[]};
export type Reducer=(i:ReduceInput)=>ReduceOutput;

// CHOOSE_ACTION selection uses director.ref precedence P1>P2>P3>P4>P5>P6 after deterministic time/world/Cause maturity handling.
// Director selection may set only the next interaction, director RNG state and bounded DirectorState trace memory.
// After any selector/transition chooses an Event, reducer materializes its declared participants before returning authoritative state or building ViewModel.
// Materialization is part of the same atomic transition: core NPC reuse consumes no RNG; generated participants consume only existing npc-stream draws and are persisted by event instance slot.
// A repeated/replayed command deterministically reuses the persisted event instance and bindings; failures return no partial NPC, binding, RNG or state mutation.
// After authoritative selection/materialization, reducer records the selected Event occurrence exactly once in RunState.events.occurrences.
// Director/Cause selectors read recurrence eligibility but never write occurrence state. ViewModel reads, retries, and Snapshot restore do not increment it.
// CHOOSE_EVENT_OPTION validates only the already-authoritative current scene and its legal choice; it does not reapply that scene's recurrence gate after selection has recorded its occurrence.

// createOfferedRun(...) is the only pure pre-reducer factory; server supplies trusted runId/playerId/rootSeed/version/metaView.
// Once GameState exists, all rule mutation goes through reduce.
// Failure: identical RuleState/stateVersion/RNG; no IO anywhere in Core.
