// EVENT DSL v0.2
type LogicalPath =
 'run.age'|'run.maxAge'|'realm.order'|'realm.cultivation'|
 'attr.insight'|'attr.body'|'attr.spiritSense'|'attr.fortune'|
 'resource.spiritStone'|'identity.tags'|'world.tags'|'world.regionId'|'injury.level';
type ConditionExpr =
 {all:ConditionExpr[]}|{any:ConditionExpr[]}|{not:ConditionExpr}|
 {eq:[LogicalPath,string|number|boolean]}|{ne:[LogicalPath,string|number|boolean]}|
 {gte:[LogicalPath,number]}|{lte:[LogicalPath,number]}|
 {hasTag:['identity.tags'|'world.tags',string]}|
 {hasItem:[string,number?]}|{buildTagGte:[string,number]}|
 {relationGte:[string,'affinity'|'trust'|'debt',number]}|
 {relationLte:[string,'affinity'|'trust'|'debt',number]}|
 {causeStateIs:[string,'dormant'|'eligible'|'echoed'|'resolved'|'expired']}|
 {npcStatusIs:[string,string]};
type RepeatBehavior='allow-cumulative';
type EffectSpec = (
 {op:'ADD_RESOURCE'|'REMOVE_RESOURCE';key:'spiritStone';amount:number}|
 {op:'ADD_ITEM'|'REMOVE_ITEM';itemId:string;amount:number}|
 {op:'ADD_CULTIVATION';amount:number}|
 {op:'ADD_CONDITION';conditionId:string;kind:string;stacks:number}|
 {op:'REMOVE_CONDITION';conditionId:string}|
 {op:'ADD_IDENTITY_TAG'|'REMOVE_IDENTITY_TAG'|'ADD_WORLD_TAG'|'REMOVE_WORLD_TAG';tag:string}|
 {op:'ADJUST_NPC_RELATION';npcId?:string;actorBindingKey?:string;affinityDelta?:number;trustDelta?:number;debtDelta?:number;reasonTag:string}|
 {op:'ADD_NPC_SIGNIFICANCE';npcId?:string;actorBindingKey?:string;amount:number;reasonTag:string}|
 {op:'REVEAL_NPC_FACT';npcId?:string;actorBindingKey?:string;factId:string;reasonTag:string}|
 {op:'REVEAL_NPC_TRAIT';npcId?:string;actorBindingKey?:string;traitTag:string;reasonTag:string}|
 {op:'REVEAL_NPC_STATUS';npcId?:string;actorBindingKey?:string;reasonTag:string}|
 {op:'SET_NPC_STATUS';npcId?:string;actorBindingKey?:string;targetStatus:'active'|'missing'|'dead'|'departed';revealToPlayer:boolean;reasonTag:string}|
 {op:'ADD_NPC_MILESTONE';npcId?:string;actorBindingKey?:string;type:string;sourceRef:string;reasonTag:string}|
 {op:'ADD_CAUSE';templateId:string;salience:1|2|3|4|5;visibility?:'hidden'|'hint'|'journal';actorBindingKeys?:Record<string,string>}|
 {op:'RESOLVE_CAUSE'|'EXPIRE_CAUSE';causeId:string}|
 {op:'RESOLVE_CAUSE'|'EXPIRE_CAUSE';triggeringCause:true}|
 {op:'GRANT_COMPONENT'|'REMOVE_COMPONENT';componentId:string}|
 {op:'SET_REGION';regionId:string}|
 {op:'OUTCOME_TIME_DELTA';years:number}|
 {op:'ADD_BUILD_EVIDENCE';buildId:string;amount:number;reasonTag:string}|

 {op:'setSessionFlag';key:string;value:boolean}|
 {op:'adjustSessionCounter';key:string;delta:number}|
 {op:'addSessionTag'|'removeSessionTag';tag:string}) & {repeatBehavior?:RepeatBehavior};

type EventSessionState={flags:Record<string,boolean>;counters:Record<string,number>;tags:string[]};

type Outcome={effects:EffectSpec[];next?:Transition[];fallbackKey?:string};
type OutcomeTable={greatSuccess?:Outcome;success:Outcome;costlySuccess?:Outcome;failure?:Outcome};
type Transition={eventId:string;when?:ConditionExpr;priority?:number};
type CheckSpec={primary:'insight'|'body'|'spiritSense'|'fortune';secondary?:'insight'|'body'|'spiritSense'|'fortune';secondaryWeightBps?:number;difficulty:number;randomMin:-10;randomMax:10};
type ChoiceDefinition={id:string;scope:'core'|'tactical';rhythmOnly?:boolean;labelKey:string;requirements?:ConditionExpr;check?:CheckSpec;threatId?:string;riskRepeatBehavior?:'allow-repeat-resolution';outcomes:OutcomeTable;next?:Transition[]};
type DirectorHints={salience:1|2|3|4|5;baseWeight?:number;topicTags:string[];continuityTags:string[];buildAffinityTags:string[];npcRoleAffinityTags:string[];worldAffinityTags:string[];onboardingEligible?:boolean};
type EventParticipantRequirement={slot:string;source:{kind:'core';npcDefinitionId:string}|{kind:'generated';archetypeId:string}};
type EventDefinition={id:string;version:number;kind:'choice'|'narrative'|'combat'|'breakthrough'|'ending'|'tutorial';titleKey:string;tags:string[];requirements?:ConditionExpr;weight:number;actionAffinity?:ActionType[];directorHints?:DirectorHints;participants?:EventParticipantRequirement[];cooldown?:{minNodesBetween?:number;maxOccurrences?:number};choices?:ChoiceDefinition[];onEnter?:EffectSpec[];ai?:unknown;fallback:{titleKey?:string;bodyKey:string};telemetry?:Record<string,string>};

// cooldown is the versioned recurrence declaration. maxOccurrences is a positive safe integer; minNodesBetween is a nonnegative safe integer.
// Missing cooldown preserves legacy eligibility. Missing maxOccurrences means no per-Run cap; missing minNodesBetween means no node cooldown.
// Event eligibility reads RunState.events.occurrences[eventId] in O(1). Candidate inspection never mutates occurrence state.
// Once an Event is authoritatively selected as the current scene, the reducer records exactly one occurrence at the selection node.
// Recurrence eligibility governs candidate selection and transition creation only. A legal choice for the already-authoritative current Event instance does not reapply its own recurrence gate; it still requires the exact current eventId and all normal choice, requirement, actor, version and state validation.
// minNodesBetween=N rejects the Event while currentNodeIndex-lastOccurrenceNodeIndex<=N and permits it at N+1.
// A recurrence declaration with maxOccurrences=1 cannot repeat and needs no repeat-effect declaration.
// For a recurrence declaration that can repeat, each cumulative Effect must individually declare repeatBehavior:'allow-cumulative'.
// Cumulative Effects are resource/item deltas, cultivation gain, condition add, NPC relation/significance/milestone deltas,
// Cause add/resolve/expire, component grant/remove, outcome time delta, and Build evidence.
// Idempotent set/reveal/remove-tag/set-region/session-local Effects need no declaration and cannot carry repeatBehavior.
// A repeatable risk Choice must declare riskRepeatBehavior:'allow-repeat-resolution'; this covers only authoritative Threat resolution and never other Effects.
// These declarations authorize intentional repeated semantics; they never patch occurrence state or bypass the normal Effect validators/resolvers.

// LogicalPath is a stable DSL namespace, NOT direct GameState property access.
// core Choice must change >=1 long-term dimension unless event explicitly marked rhythm-only.
// tactical Choice may change only combat/session-local state; it is exempt from long-term-choice lint but must be meaningful.
// CheckSpec.difficulty is an integer target in 0..1000, not a probability percentage.
// secondaryWeightBps is an integer in 0..10000 and defaults to 5000.
// scaledSecondary = 0 when secondary=0; otherwise sign(secondary)*roundHalfUpPositive(abs(secondary)*secondaryWeightBps,10000).
// baseScore = primary + scaledSecondary. primary and secondary may be positive, zero, or negative; all intermediates must be safe integers.
// Each Check makes exactly one logical RNG request: unbiasedInt(-10,10) on the check stream.
// The request uses the existing deterministic rejection-sampling helper and may consume one or rarely multiple underlying uint32 draws.
// Every underlying draw stays on the check stream, advances the actual drawIndex, and appears in trace in reproducible order.
// Outcome tier resolution and optional-tier fallback make no additional RNG request; fallback consumes zero RNG.
// finalScore = baseScore + rngRoll. Resolve in order: greatSuccess when finalScore>=difficulty+10; success when >=difficulty;
// costlySuccess when finalScore>=difficulty-10; otherwise failure.
// Missing greatSuccess or costlySuccess falls back to success. Missing failure falls back to costlySuccess, then success.
// Tier fallback consumes no additional RNG.
// rhythmOnly defaults false and is allowed only for core Choice. A rhythm-only Choice must have a valid next transition to a different eventId.
// Tactical session-local effects are exactly setSessionFlag, adjustSessionCounter, addSessionTag, removeSessionTag.
// They mutate only EventSessionState and never RuleState or MetaState.
// A tactical Choice is meaningful iff it has at least one valid session-local effect, a valid CheckSpec, or a valid next transition to a different eventId.
// Content cannot author riskHint. UI risk language is derived later (UI01).
// ADD_BUILD_EVIDENCE is authoritative semantic evidence only; amount/buildId/reasonTag are content-authored and validated against the locked BuildPack.
// NPC effects target exactly one authoritative npcId or actorBindingKey and are validated against the locked NpcPack. Full NpcInstance replacement is forbidden.
// A choice is executable only if its OutcomeTable declares a success or failure tier; with neither tier an outcome can never resolve, and OutcomeTable otherwise requires a success tier.
// RESOLVE_CAUSE/EXPIRE_CAUSE target exactly one Cause: either an author-time causeId, or the triggering Cause via triggeringCause:true. Exactly one of the two is required, never both.
// triggeringCause:true is the only legal way to reference the Cause selected by P3. It is legal only when the Event is reached as a P3 Cause echo, and resolves at runtime to the exact bound CauseInstance.causeId.
// Its Content requirement is only that the Event be Cause-linked: some CauseTemplate.linkedEventIds must contain it, so an authoritative triggering Cause can exist for that scene.
// Cause actor roles are content meaning (rescuedNpc, master, debtor, enemy, witness, and any other legal role) and are never renamed, reserved or constrained by this mechanism.
// Safety does not come from a role name: it comes from the runtime reading the persisted events.current.triggeringCauseId, so an unbound scene fails closed however the Cause was authored.
// At runtime the reference resolves only from the authoritative current-scene Cause binding; it never looks up a CauseTemplate, never searches active Causes by templateId, actor, salience or any other signal, and never fabricates one.
// No triggering Cause, no authoritative binding, or a bound Cause that is missing or already terminal => fail closed: no RNG, no partial state mutation, and the same INVALID_OPTION cause.invalid surface as any other invalid Cause effect.
// A triggeringCause Effect may declare repeatBehavior:'allow-cumulative' exactly like its causeId form, when its owning Event can repeat.
// Lifetime asymmetry is intentional: after the triggering Cause is resolved or expired the scene may remain current, and repeating the Effect then fails closed. An authored transition or continuation is how such a scene ends.
// A risk Choice references one registered threatId and uses that ThreatDefinition CheckSpec; it cannot declare a second CheckSpec.
// END_RUN, killPlayer, setDead, forceDeath and equivalent direct-death effects are forbidden. Only lifespan handling or RISK01 RiskResolver may enter death/dying.
// ActionType is the command/state ActionType; no second action enum exists. actionAffinity classifies selector candidates only.
// Missing/empty actionAffinity means ordinary fallback unless the Event is reserved by a higher selector tier (for example a Cause-linked echo). Unknown ActionType is invalid content.
// directorHints is declarative selector metadata governed by director.ref; every hint tag must be declared by the locked Content Pack.
// A playable Content Pack must contain at least one ordinary fallback Event.
// participants is declarative only. slot is a unique safe event-local binding key; sources reference the locked NpcPack by stable ID.
// Content cannot provide a concrete npcId, generated traits/name/seed/state, executable materializer, or any other authoritative NPC state.
// Director selection reads metadata only. The authoritative reducer materializes participants after selection and before ViewModel projection.
// No arbitrary function/path/code. Unknown operator/effect/path => lint+runtime reject.
