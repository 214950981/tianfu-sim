// COMMAND CONTRACT v0.2
export type CommandEnvelope<T extends GameCommand>={commandId:string;playerId:string;runId:string;expectedStateVersion:number;rulesVersion:string;contentVersion:string;clientPlatform:'wechat'|'douyin'|'dev';clientBuild:string;issuedAtClient?:number;command:T};

export type GameCommand=
 |{type:'START_RUN';offerId:string;destinyId:string}
 |{type:'CHOOSE_ACTION';actionId:'cultivate'|'travel'|'worldly'|'pursuit';pursuitCauseId?:string}
 |{type:'CHOOSE_EVENT_OPTION';eventId:string;optionId:string}
 |{type:'EQUIP_TECHNIQUE';componentId:string;slot:number}
 |{type:'EQUIP_ARTIFACT';componentId:string;slot:number}
 |{type:'USE_ITEM';itemId:string}
 |{type:'TRAVEL';regionId:string}
 |{type:'JOIN_FACTION';factionId:string}
 |{type:'LEAVE_FACTION';factionId:string}
 |{type:'START_BREAKTHROUGH';targetRealmId:string}
 |{type:'CHOOSE_BREAKTHROUGH_OPTION';sessionId:string;optionId:string}
 |{type:'RESPOND_NPC';npcId:string;intentId:string}
 |{type:'ABANDON_RUN'}
 |{type:'CLAIM_META_UNLOCK';unlockId:string};

export type AppErrorCode='INVALID_COMMAND'|'INVALID_OPTION'|'STATE_CONFLICT'|'UNAUTHORIZED'|'CONTENT_MISMATCH'|'RUN_NOT_ACTIVE'|'RUN_OFFER_MISMATCH'|'TRANSIENT';
export type CommandResult={ok:boolean;commandId:string;stateVersion:number;statePatch?:ViewStatePatch;domainEffects?:PublicEffect[];narrative?:NarrativePayload;error?:{code:AppErrorCode;messageKey:string;retryable:boolean}};

// Server creates PendingRunOffer (not client): {runId,offerId,rootSeed,rulesVersion,contentVersion,metaViewHash,destinyIds[3],stateVersion:0}.
// START_RUN must choose exactly one offered destiny and consumes offer once.
