/* pages/game/game.wxss */

/* ==========================================================
   1. 基础布局与极暗黑环境
   ========================================================== */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #030303; /* 极致深邃的虚空背景 */
  color: #eeeeee;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
}

/* ==========================================================
   2. 顶部监控台 (境界、兵解与经验)
   ========================================================== */
.header-monitor {
  flex-shrink: 0;
  padding: max(30rpx, env(safe-area-inset-top)) 40rpx 20rpx;
  background: linear-gradient(180deg, #151515 0%, #030303 100%);
  border-bottom: 2rpx solid #1a1a1a;
  position: relative;
  z-index: 10;
}

.realm-box {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  margin-bottom: 25rpx;
}

.realm-title {
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-shadow: 0 0 20rpx rgba(255,255,255,0.1);
}

.suicide-btn {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #888;
  background: #111;
  padding: 8rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #333;
  transition: all 0.2s;
}
.suicide-btn:active { background: #d32f2f; color: #fff; border-color: #d32f2f; }

/* 经验条系统 */
.exp-progress-wrap {
  height: 6rpx;
  background: #222;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  box-shadow: inset 0 0 5rpx #000;
}

.exp-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease-out; 
  box-shadow: 0 0 10rpx rgba(0, 242, 254, 0.5);
}

.exp-text {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #777;
  font-family: 'Courier New', Courier, monospace;
}

/* ==========================================================
   3. 全面扩展的数值雷达 (5宫格)
   ========================================================== */
.stats-grid {
  flex-shrink: 0;
  display: flex;
  padding: 20rpx 10rpx;
  background: #0a0a0a;
  border-bottom: 2rpx solid #1a1a1a;
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.5);
  z-index: 9;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 2rpx solid #1a1a1a;
}
.stat-card:last-child { border-right: none; }

.stat-label {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.stat-val {
  font-size: 26rpx;
  font-weight: bold;
  font-family: 'Courier New', Courier, monospace; 
  text-align: center;
}

/* 核心数值发光色系 */
.text-danger { color: #ff5252; animation: blink-red 0.8s infinite alternate; }
.text-blue { color: #448aff; text-shadow: 0 0 10rpx rgba(68,138,255,0.4); }
.text-gold { color: #ffd700; text-shadow: 0 0 10rpx rgba(255,215,0,0.3); }
.text-diamond { color: #00e5ff; text-shadow: 0 0 15rpx rgba(0,229,255,0.5); font-weight: 900; }

@keyframes blink-red {
  0% { opacity: 0.6; text-shadow: 0 0 0 transparent; }
  100% { opacity: 1; text-shadow: 0 0 15rpx #ff5252; transform: scale(1.05); }
}

/* 灵根与境界共用的发光色系 */
.Gray { color: #888; }
.Green { color: #4caf50; text-shadow: 0 0 10rpx rgba(76,175,80,0.3); }
.Blue { color: #2196f3; text-shadow: 0 0 10rpx rgba(33,150,243,0.3); }
.Purple { color: #9c27b0; text-shadow: 0 0 15rpx rgba(156,39,176,0.5); }
.Orange { color: #ff9800; text-shadow: 0 0 20rpx rgba(255,152,0,0.6); }
.Gold { color: #ffd700; text-shadow: 0 0 25rpx rgba(255,215,0,0.8); }
.Red { color: #ff3333; text-shadow: 0 0 25rpx rgba(255,51,51,0.8); }

/* ==========================================================
   4. 岁月信息流 (修仙日志池)
   ========================================================== */
.log-scroll-view {
  flex: 1;
  height: 0; 
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  background: #050505;
}

.log-row {
  margin-bottom: 20rpx;
  line-height: 1.6;
  font-size: 26rpx;
  animation: logFadeIn 0.3s ease-out forwards; 
}

@keyframes logFadeIn {
  from { opacity: 0; transform: translateX(-10rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.log-year {
  color: #555;
  font-family: 'Courier New', Courier, monospace;
  margin-right: 12rpx;
  font-size: 24rpx;
}

/* 日志基础底色 (高亮部分由 WXS 处理) */
.log-row.normal .log-content { color: #bbbbbb; }
.log-row.event-epic .log-content { color: #ffb300; font-weight: bold; }
.log-row.event-breakthrough .log-content { color: #00e676; font-weight: bold; }
.log-row.event-deadly .log-content { color: #ef5350; }

.anchor-point { height: 30rpx; width: 100%; }

/* ==========================================================
   5. 底部中央控制台 (双排交互布局)
   ========================================================== */
.footer-control-panel {
  flex-shrink: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #0d0d0d;
  border-top: 2rpx solid #1a1a1a;
  box-shadow: 0 -10rpx 30rpx rgba(0,0,0,0.8);
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* 两排按钮之间的间距 */
  z-index: 10;
}

/* --- 第一排：功能入口 --- */
.action-row-top {
  display: flex;
  justify-content: space-between;
  gap: 15rpx;
}

.btn-minor {
  flex: 1;
  background: #161616;
  color: #aaa;
  font-size: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 12rpx;
  border: 1rpx solid #333;
  transition: all 0.2s;
}
.btn-minor:active { background: #222; transform: scale(0.95); }

/* 一键飞升专属土豪金高亮 */
.btn-skip {
  background: rgba(255, 215, 0, 0.05);
  color: #ffd700;
  border-color: rgba(255, 215, 0, 0.3);
  font-weight: bold;
}
.btn-skip:active { background: rgba(255, 215, 0, 0.15); }

/* --- 第二排：核心引擎控制 --- */
.engine-controls {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.btn-engine, .btn-speed {
  flex: 1;
  height: 96rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: bold;
  transition: all 0.2s;
}

.icon { margin-right: 12rpx; font-size: 34rpx; }

/* 挂机中 */
.engine-running {
  background: rgba(0, 230, 118, 0.1);
  color: #00e676;
  border: 2rpx solid rgba(0, 230, 118, 0.4);
}
.engine-running:active { background: rgba(0, 230, 118, 0.2); transform: scale(0.96); }

/* 暂停中 */
.engine-paused {
  background: rgba(255, 152, 0, 0.1);
  color: #ffb300;
  border: 2rpx solid rgba(255, 152, 0, 0.4);
}
.engine-paused:active { background: rgba(255, 152, 0, 0.2); transform: scale(0.96); }

/* ==========================================================
   5b. 修为数值 (续接被截断的 .engine-paused 之后)
   ========================================================== */
.exp-nums {
  color: #555;
}

/* ==========================================================
   6. 五维属性条 (家境/体魄/根骨/福源/悟性 + 雷劫胜率)
   ========================================================== */
.attr-bar {
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
  background: #080808;
  border-bottom: 2rpx solid #1a1a1a;
}

.attr-item {
  flex: 1;
  min-width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 6rpx;
}

.attr-name {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.attr-val {
  font-size: 26rpx;
  font-weight: bold;
  color: #ddd;
  font-family: 'Courier New', Courier, monospace;
}

/* 雷劫胜率独立标色 */
.rate-box {
  flex: 1.4;
  flex-direction: row;
  justify-content: center;
  gap: 10rpx;
  align-items: center;
  background: rgba(255, 82, 82, 0.06);
  border: 1rpx solid rgba(255, 82, 82, 0.25);
  border-radius: 12rpx;
  margin: 6rpx 4rpx;
}

/* 游历中：修为条压制色 */
.bar-wandering {
  background: linear-gradient(90deg, #ff9800 0%, #ffd700 100%);
  box-shadow: 0 0 10rpx rgba(255, 152, 0, 0.5);
}

/* ==========================================================
   7. 底部按钮矩阵 (引擎/飞升/游历/流速)
   ========================================================== */
.btn-matrix {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 15rpx;
}

.game-btn {
  flex: 1 1 45%;
  min-width: 200rpx;
  height: 96rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14rpx;
  margin: 0;
  padding: 0 16rpx;
  background: #161616;
  color: #aaa;
  border-radius: 16rpx;
  border: 1rpx solid #333;
  transition: all 0.2s;
  box-sizing: border-box;
}
.game-btn::after { border: none; }
.game-btn:active { background: #222; transform: scale(0.96); }

/* 运行中 */
.btn-active {
  background: rgba(0, 230, 118, 0.1);
  color: #00e676;
  border-color: rgba(0, 230, 118, 0.4);
}

/* 游历中 */
.btn-wander {
  background: rgba(255, 152, 0, 0.1);
  color: #ffb300;
  border-color: rgba(255, 152, 0, 0.4);
}

.btn-icon {
  font-size: 36rpx;
  line-height: 1;
}

.btn-texts {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.btn-main {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1.3;
}

.btn-sub {
  font-size: 20rpx;
  opacity: 0.7;
  line-height: 1.3;
}

/* 可点击的数值卡片 (钻石入口) */
.clickable-card:active { background: #141414; }

/* ==========================================================
   8. 雷劫瓶颈
   ========================================================== */
.tribulation-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.btn-tribulation {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0;
  padding: 0;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #fff;
  background: linear-gradient(135deg, #b71c1c 0%, #ff5252 100%);
  border-radius: 48rpx;
  border: 2rpx solid rgba(255, 82, 82, 0.6);
  box-shadow: 0 0 24rpx rgba(255, 82, 82, 0.45);
  box-sizing: border-box;
}
.btn-tribulation::after { border: none; }
.btn-tribulation:active { transform: scale(0.97); box-shadow: 0 0 10rpx rgba(255, 82, 82, 0.3); }

.tribulation-hint {
  font-size: 22rpx;
  color: #ff8a80;
}

/* ==========================================================
   9. 死亡与轮回
   ========================================================== */
.dead-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.dead-tips {
  font-size: 26rpx;
  color: #777;
  text-align: center;
}

.btn-rebirth {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffd700;
  background: rgba(255, 215, 0, 0.08);
  border: 2rpx solid rgba(255, 215, 0, 0.35);
  border-radius: 44rpx;
  box-sizing: border-box;
}
.btn-rebirth::after { border: none; }
.btn-rebirth:active { background: rgba(255, 215, 0, 0.18); }

.text-merit {
  color: #ffd700;
  font-weight: bold;
}

/* ==========================================================
   10. 弹窗通用层
   ========================================================== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.82);
  z-index: 100;
}

.modal-content {
  width: 100%;
  max-width: 620rpx;
  max-height: 80vh;
  padding: 36rpx 32rpx;
  background: #111;
  border: 2rpx solid #2a2a2a;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.9);
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-align: center;
  color: #eee;
  margin-bottom: 28rpx;
}

.modal-body {
  font-size: 26rpx;
  color: #bbb;
}

.text-center { text-align: center; }

.close-btn {
  margin-left: 16rpx;
  font-size: 40rpx;
  line-height: 1;
  color: #888;
  font-weight: normal;
}
.close-btn:active { color: #fff; }

.divider {
  margin: 28rpx 0;
  font-size: 22rpx;
  color: #666;
  text-align: center;
  letter-spacing: 2rpx;
}

.highlight {
  font-weight: bold;
  font-family: 'Courier New', Courier, monospace;
}

.hint-text {
  display: block;
  font-size: 22rpx;
  color: #777;
  line-height: 1.5;
}

.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mt-10 { margin-top: 10rpx; }

/* ==========================================================
   11. 功德/轮回弹窗
   ========================================================== */
.death-modal {
  border-color: rgba(255, 215, 0, 0.3);
}

.death-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.death-text {
  display: block;
  font-size: 28rpx;
  color: #ddd;
  margin-bottom: 28rpx;
}

.merit-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 215, 0, 0.06);
  border: 1rpx solid rgba(255, 215, 0, 0.25);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.merit-label {
  font-size: 22rpx;
  color: #999;
}

.merit-val {
  font-size: 40rpx;
  font-weight: 900;
}

.btn-share-rebirth {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin: 0 0 20rpx;
  padding: 0;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffd700;
  background: rgba(255, 215, 0, 0.12);
  border: 2rpx solid rgba(255, 215, 0, 0.4);
  border-radius: 42rpx;
  box-sizing: border-box;
}
.btn-share-rebirth::after { border: none; }
.btn-share-rebirth:active { background: rgba(255, 215, 0, 0.22); }

.btn-cancel-rebirth {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  color: #aaa;
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 42rpx;
  box-sizing: border-box;
}
.btn-cancel-rebirth::after { border: none; }
.btn-cancel-rebirth:active { background: #242424; }

/* ==========================================================
   12. 岁月流速弹窗
   ========================================================== */
.speed-modal {
  max-width: 560rpx;
}

.speed-status {
  display: block;
  font-size: 26rpx;
  color: #ccc;
  margin-bottom: 24rpx;
}

.speed-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.speed-item {
  width: 92rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #aaa;
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 12rpx;
  box-sizing: border-box;
  transition: all 0.15s;
}
.speed-item:active { transform: scale(0.94); }

.speed-item.active {
  color: #030303;
  background: linear-gradient(135deg, #ffd700 0%, #ffb300 100%);
  border-color: #ffd700;
  box-shadow: 0 0 14rpx rgba(255, 215, 0, 0.45);
}

.unlock-pay {
  margin-top: 8rpx;
}

.unlock-free {
  margin-top: 8rpx;
}

/* 看广告免费解锁流速 */
.btn-ad {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 0 20rpx;
  padding: 0;
  font-size: 24rpx;
  font-weight: bold;
  color: #00e676;
  background: rgba(0, 230, 118, 0.1);
  border: 2rpx solid rgba(0, 230, 118, 0.35);
  border-radius: 40rpx;
  box-sizing: border-box;
}
.btn-ad::after { border: none; }
.btn-ad:active { background: rgba(0, 230, 118, 0.2); }

/* 分享免费解锁流速 */
.btn-share {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  font-size: 24rpx;
  font-weight: bold;
  color: #ffd700;
  background: rgba(255, 215, 0, 0.1);
  border: 2rpx solid rgba(255, 215, 0, 0.35);
  border-radius: 40rpx;
  box-sizing: border-box;
}
.btn-share::after { border: none; }
.btn-share:active { background: rgba(255, 215, 0, 0.2); }

.btn-pay-speed {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  font-size: 24rpx;
  font-weight: bold;
  color: #00e5ff;
  background: rgba(0, 229, 255, 0.1);
  border: 2rpx solid rgba(0, 229, 255, 0.35);
  border-radius: 40rpx;
  box-sizing: border-box;
}
.btn-pay-speed::after { border: none; }
.btn-pay-speed:active { background: rgba(0, 229, 255, 0.2); }

/* ==========================================================
   13. 福利商行 (钻石)
   ========================================================== */
.recharge-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 20rpx;
  margin-top: 10rpx;
}

/* 单列排布 (商行按钮自带定宽) */
.recharge-grid.single-item {
  flex-direction: column;
  align-items: center;
}

.recharge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  height: 200rpx;
  margin: 0;
  padding: 20rpx 0;
  background: #161616;
  border: 2rpx solid rgba(255, 215, 0, 0.25);
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}
.recharge-item::after { border: none; }
.recharge-item:active { background: #1f1f1f; transform: scale(0.97); }

.r-icon {
  font-size: 52rpx;
  line-height: 1;
}

.r-base {
  font-size: 30rpx;
  font-weight: 900;
  color: #ffd700;
  font-family: 'Courier New', Courier, monospace;
}

.r-price {
  font-size: 22rpx;
  color: #999;
}

.r-bonus {
  font-size: 20rpx;
  color: #00e676;
  font-weight: bold;
}

.recharge-notice {
  display: block;
}

/* ==========================================================
   14. 授权面板 (真容与道号)
   ========================================================== */
.auth-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.92);
  z-index: 200;
}

.auth-panel {
  width: 100%;
  max-width: 560rpx;
  padding: 40rpx 32rpx;
  background: #111;
  border: 2rpx solid #2a2a2a;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.auth-title {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-align: center;
  color: #eee;
  margin-bottom: 16rpx;
}

.auth-desc {
  display: block;
  font-size: 22rpx;
  color: #777;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.avatar-btn {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto 12rpx;
  padding: 0;
  background: #1a1a1a;
  border: 2rpx dashed #444;
  border-radius: 90rpx;
  overflow: hidden;
  line-height: normal;
  box-sizing: border-box;
}
.avatar-btn::after { border: none; }

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 90rpx;
}

.avatar-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 0;
  font-size: 20rpx;
  color: #ddd;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
}

.nickname-box {
  margin-bottom: 28rpx;
}

.nickname-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #eee;
  text-align: center;
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 42rpx;
  box-sizing: border-box;
}

.auth-submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #030303;
  background: linear-gradient(135deg, #ffd700 0%, #ffb300 100%);
  border-radius: 44rpx;
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.35);
  box-sizing: border-box;
}
.auth-submit-btn::after { border: none; }
.auth-submit-btn:active { transform: scale(0.98); }

