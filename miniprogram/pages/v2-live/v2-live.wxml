<!-- UI04C dev-only live client.

     One screen, four surfaces read straight out of the authoritative server projection:
       - 择命   (DESTINY_OFFER)  : the offered candidates, exactly as the server published them
       - 在世   (RUN_HOME)       : public vitals, the four projected core actions, a projected
                                   breakthrough action when the server enables one, and the read-only
                                   LIFE_ARCHIVE side page
       - 抉择   (EVENT / SPECIAL_NODE) : the current interaction, its public body and its options with
                                   the server-built riskPresentation
       - 终局   (ENDING / LIFE_BOOK / REBIRTH_RESULT / NEXT_LIFE) : a bounded note only
     plus the client's own transport state (loading / submitting / retry / conflict / fatal) and a
     bounded, staged diagnostic when the session cannot be created.

     No gameplay value is computed here: every label resolves a server-projected key, and every
     submission is an intent that CommandSubmissionController turns into an envelope. -->
<view class="screen">

  <view class="surface">

    <view wx:if="{{stage === 'loading'}}" class="panel">
      <view class="panel-title">正在连接服务器</view>
      <view class="panel-note">建立此生命局，请稍候…</view>
    </view>

    <view wx:elif="{{stage === 'error'}}" class="panel">
      <view class="panel-title">无法进入此世</view>
      <view class="fail-row">
        <view class="fail-key">阶段</view>
        <view class="fail-value">{{failure.stage}}</view>
      </view>
      <view class="fail-row">
        <view class="fail-key">代码</view>
        <view class="fail-value">{{failure.code}}</view>
      </view>
      <view class="fail-row" wx:if="{{failure.detail}}">
        <view class="fail-key">详情</view>
        <view class="fail-value">{{failure.detail}}</view>
      </view>
      <view class="fail-row">
        <view class="fail-key">模块</view>
        <view class="fail-value">{{failure.specifier}}</view>
      </view>
      <view class="panel-note">{{failure.hint}}</view>
      <view class="cta" bindtap="onReload">重新连接</view>
    </view>

    <block wx:else>
      <view class="topline">
        <view class="topline-name">{{vm.runName}}</view>
        <view class="topline-meta">{{vm.pageStateLabel}} · 第 {{vm.stateVersion}} 版</view>
      </view>

      <view wx:if="{{vm.banner}}" class="banner banner-{{vm.banner.kind}}">
        <view class="banner-text">{{vm.banner.text}}</view>
        <view class="banner-actions">
          <view wx:if="{{vm.banner.kind === 'retry'}}" class="banner-action" bindtap="onRetry">重试</view>
          <view wx:if="{{vm.banner.kind === 'conflict'}}" class="banner-action" bindtap="onReconfirm">重新确认</view>
          <view wx:if="{{vm.banner.kind === 'fatal'}}" class="banner-action" bindtap="onReload">重新连接</view>
        </view>
      </view>

      <!-- ------------------------------------------------ 本次结果 RESULT RECEIPT (PLAYUX01 B1) -->
      <!-- The settled command's own account of what it changed. It renders as a full-screen panel so the
           player reads it before anything else moves, and its one control only dismisses: the settlement
           is already committed, so returning to 在世 must not re-issue the choice. Every line here comes
           from the authoritative receipt; when the settlement changed nothing measurable the panel says
           so instead of inventing a gain. -->
      <view wx:if="{{vm.hasResult}}" class="result-overlay">
        <view class="result-head">
          <view class="result-title">{{vm.result.heading}}</view>
          <!-- PLAYUX01 (F1): what happened, named. The Event title comes from the receipt's own eventId and
               the option from its choiceId, both resolved through the same exact-key catalog as every other
               surface; a missing entry reads as 详情暂不可用, never as an internal code. -->
          <view wx:if="{{vm.result.eventTitle}}" class="result-event">{{vm.result.eventTitle}}</view>
        </view>
        <scroll-view class="overlay-body" scroll-y="true">
          <view wx:if="{{vm.result.hasChoice}}" class="result-choice">{{vm.result.youChosePrefix}}{{vm.result.choiceLabel}}</view>
          <!-- PLAYFEEL01 (B2): the locked order is 事件 -> 你选择了什么 -> 事情怎样发生 -> 真实变化与代价 ->
               后续影响/建议 -> 继续. The narration is the scene's own authored account of the option that
               settled, read by exact key from the settled receipt's eventId, choiceId and applied tier. It
               sits above the numbers on purpose: 修为 +140 with no account of what happened is exactly the
               complaint the brief records. When a scene has no authored settlement nothing is printed here
               rather than a sentence that would fit any scene. -->
          <view wx:if="{{vm.result.hasNarration}}" class="result-narration">{{vm.result.narration}}</view>
          <view wx:if="{{vm.result.lines.length > 0}}">
            <view wx:for="{{vm.result.lines}}" wx:key="key" class="result-line">{{item.text}}</view>
          </view>
          <!-- A settlement that produced nothing beyond time says so. When the scene authored its own
               resolution note that is used instead, because it can be specific ("尚未取得可以确认的新线索")
               where the client cannot; the note is only reachable when nothing was gained, so it can never
               contradict the lines above. -->
          <view wx:if="{{vm.result.resolutionNote}}" class="body-text">{{vm.result.resolutionNote}}</view>
          <view wx:elif="{{vm.result.noGainText}}" class="body-text">{{vm.result.noGainText}}</view>
        </scroll-view>
        <view class="cta" bindtap="onDismissResult">{{vm.result.ctaLabel}}</view>
      </view>

      <!-- ------------------------------------------------ 择命 DESTINY_OFFER -->
      <view wx:if="{{vm.isOffer}}" class="block">
        <view class="block-title">{{vm.offerTitle}}</view>
        <scroll-view class="bounded" scroll-y="true">
          <view wx:for="{{vm.offerCandidates}}" wx:key="optionId" class="card">
            <view class="card-title">{{item.title}}</view>
            <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="label" class="card-row">
              <view class="card-key">{{row.label}}</view>
              <view class="card-value">{{row.value}}</view>
            </view>
            <view class="cta" data-option-id="{{item.optionId}}" bindtap="onOption">择定此命</view>
          </view>
        </scroll-view>
      </view>

      <!-- ------------------------------------------------ 在世 RUN_HOME -->
      <!-- PLAYFEEL01 (B1): the home screen is where "I am a cultivator working toward something" has to be
           legible. It shows the run's own 灵根, the realm, the progress toward the pack's 10000 threshold,
           the years left and the recorded injuries, then a single 近期目标 sentence and the server's own
           breakthrough availability with its published blocked reason. Every value is server-projected; the
           page computes no score and promises no odds. -->
      <view wx:elif="{{vm.isHome}}" class="block">
        <view class="vitals">
          <view class="vital">
            <view class="vital-key">灵根</view>
            <view class="vital-value">{{vm.rootName}}</view>
          </view>
          <view class="vital">
            <view class="vital-key">境界</view>
            <view class="vital-value">{{vm.realmLabel}}</view>
          </view>
          <view class="vital">
            <view class="vital-key">修为</view>
            <view class="vital-value">{{vm.cultivation}} / 10000</view>
          </view>
          <view class="vital">
            <view class="vital-key">寿元</view>
            <view class="vital-value">{{vm.age}} / {{vm.maxAge}}</view>
          </view>
          <view class="vital">
            <view class="vital-key">灵石</view>
            <view class="vital-value">{{vm.spiritStone}}</view>
          </view>
        </view>

        <view class="goal goal-{{vm.goalTone}}">{{vm.goalLine}}</view>
        <view wx:if="{{vm.injuryText}}" class="goal-note">{{vm.injuryText}}</view>

        <view class="actions">
          <view wx:for="{{vm.coreActions}}" wx:key="intentId" class="action {{item.enabled ? 'is-on' : 'is-off'}}" data-intent-id="{{item.intentId}}" bindtap="onCoreAction">
            {{item.label}}
          </view>
        </view>
        <view class="actions-note">闭关 · 游历 · 入世 · 追索</view>

        <view wx:if="{{vm.specialActions.length > 0}}" class="actions">
          <view wx:for="{{vm.specialActions}}" wx:key="intentId" class="cta {{item.enabled ? '' : 'is-off'}}" data-intent-id="{{item.intentId}}" bindtap="onSpecialAction">
            {{item.label}}
          </view>
          <view wx:if="{{vm.specialActions[0].reason}}" class="actions-note">{{vm.specialActions[0].reason}}</view>
        </view>

        <view class="cta ghost" bindtap="onOpenArchive">打开生平录</view>
      </view>

      <!-- ------------------------------------------------ 抉择 EVENT / SPECIAL_NODE -->
      <view wx:elif="{{vm.isDecision}}" class="block">
        <view class="block-title">{{vm.decisionTitle}}</view>
        <view wx:if="{{vm.decisionBody}}" class="body-text">{{vm.decisionBody}}</view>
        <scroll-view class="bounded" scroll-y="true">
          <!-- PLAYFEEL01 (B4): the brief bans three identical black decision buttons and asks for the option
               itself to be tappable. The card is now the hit target; `onOption` reads optionId off
               currentTarget, so the behaviour is unchanged. Each option already carries its own verb,
               risk line and known cost, so there is nothing for a shared button to say. -->
          <view wx:for="{{vm.options}}" wx:key="optionId" class="card option-card" data-option-id="{{item.optionId}}" bindtap="onOption">
            <view class="card-main">
              <view class="card-title">{{item.label}}</view>
              <view wx:if="{{item.riskLabel}}" class="risk {{item.riskClass}}">
                <text class="risk-label">{{item.riskLabel}}</text>
                <text wx:if="{{item.fatal}}" class="risk-fatal">可致死</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- ------------------------------------------------ 终局 ENDING -->
      <!-- PLAYUX01 (B2): ENDING answers "when did it end, why, and what did I leave behind". The counts
           come from the same shared basis as LIFE_BOOK and REBIRTH_RESULT, so the same run cannot read
           11 experiences here and 0 there. When the sidecar has not been written yet the screen says the
           record is being assembled — it does not report zeroes, which would be a verdict on a life
           nobody has summarised. -->
      <view wx:if="{{vm.isTerminal && vm.terminal && vm.terminal.isEnding}}" class="block">
        <view class="block-title">此生已终</view>
        <view wx:if="{{vm.terminal.lifeBook.runName}}" class="body-text">{{vm.terminal.lifeBook.runName}} · {{vm.terminal.lifeBook.age}} / {{vm.terminal.lifeBook.maxAge}} · {{vm.terminal.lifeBook.realm}}</view>
        <view wx:if="{{!vm.terminal.lifeBook.hasLifeBook}}" class="body-text">此生记录整理中，卷宗尚未生成。</view>
        <view wx:if="{{vm.terminal.lifeBook.hasLifeBook && vm.terminal.lifeBook.hasDeath}}" class="body-text">{{vm.terminal.lifeBook.deathDetail}}</view>
        <view wx:if="{{vm.terminal.lifeBook.hasLifeBook}}" class="body-text">此生留下 {{vm.terminal.lifeBook.counts.experiences}} 件往事、{{vm.terminal.lifeBook.counts.people}} 位故人、{{vm.terminal.lifeBook.counts.paths}} 条道途、{{vm.terminal.lifeBook.counts.causes}} 段公开因果。</view>
        <view wx:if="{{vm.terminalCta}}" class="cta" data-action="{{vm.terminalCta.action}}" bindtap="onTerminalAdvance">{{vm.terminalCta.label}}</view>
      </view>

      <!-- ------------------------------------------------ 人生书 LIFE_BOOK -->
      <!-- PLAYUX01 (F2): a retrospective, and the sections say what they actually are. The chronological list
           is 此生经历 — a record, not a ranking: the public projection carries no per-Event significance, so
           calling each row a turning point would assert a judgement the data does not contain. The life's
           actual shape is presented separately, from the only significance signals that ARE published: a
           track the server marked dominant, a cause that reached journal visibility, and the people met. -->
      <view wx:elif="{{vm.isTerminal && vm.terminal && vm.terminal.isLifeBook}}" class="block">
        <view class="block-title">人生书</view>
        <view wx:if="{{vm.terminal.lifeBook.runName}}" class="body-text">{{vm.terminal.lifeBook.runName}} · {{vm.terminal.lifeBook.age}} / {{vm.terminal.lifeBook.maxAge}} · {{vm.terminal.lifeBook.realm}}</view>
        <view wx:if="{{!vm.terminal.lifeBook.hasLifeBook}}" class="body-text">此生记录整理中，卷宗尚未生成。</view>
        <view wx:if="{{vm.terminal.lifeBook.intro}}" class="body-text">{{vm.terminal.lifeBook.intro}}</view>
        <scroll-view wx:if="{{vm.terminal.lifeBook.hasLifeBook}}" class="bounded" scroll-y="true">
          <view wx:if="{{vm.terminal.lifeBook.timeline.length > 0}}" class="archive-section">
            <view class="archive-section-title">此生经历</view>
            <view wx:for="{{vm.terminal.lifeBook.timeline}}" wx:key="key" class="archive-row">
              <!-- PLAYFEEL01 (B4): "第 N 节点" is a development field, not a player-facing one, and the brief
                   bans it outright. The row keeps its chronological position but names it as an entry in the
                   record. -->
              <view class="archive-kind">第 {{item.order}} 事</view>
              <view class="archive-main">
                <view class="archive-title">{{item.title}}</view>
                <view wx:if="{{item.body}}" class="archive-summary">{{item.body}}</view>
                <view wx:if="{{item.hasChoice}}" class="archive-summary">当时选择：{{item.choiceLabel}}</view>
                <view wx:else class="archive-summary">此前选择未记录</view>
                <!-- PLAYFEEL01 (B2): what that choice actually settled. The opening body above is what the
                     scene was; this is what came of it, from the same per-option settlement catalog the
                     result panel reads. A row with no authored settlement shows nothing here, so the life
                     book can never pass the opening text off as an outcome. -->
                <view wx:if="{{item.hasSettled}}" class="archive-settled">{{item.settledText}}</view>
              </view>
            </view>
          </view>

          <view wx:if="{{vm.terminal.lifeBook.hasTransitions}}" class="archive-section">
            <view class="archive-section-title">此生的变化</view>
            <view wx:for="{{vm.terminal.lifeBook.trackRows}}" wx:key="buildId" class="card-row">
              <view class="card-key">道途 · {{item.name}}</view>
              <view class="card-value">{{item.stageLabel}}{{item.dominant ? ' · 主修' : ''}}</view>
            </view>
            <view wx:for="{{vm.terminal.lifeBook.causeRows}}" wx:key="key" class="card-row">
              <view class="card-key">因果 · {{item.levelLabel}}</view>
              <view class="card-value">{{item.text}}</view>
            </view>
            <view wx:for="{{vm.terminal.lifeBook.peopleRows}}" wx:key="npcId" class="card-row">
              <view class="card-key">故人 · {{item.displayName}}</view>
              <view class="card-value">{{item.statusLabel}}</view>
            </view>
          </view>

          <view wx:if="{{vm.terminal.lifeBook.hasEnding}}" class="card">
            <view class="card-title">终局</view>
            <view class="card-row"><view class="card-key">结局</view><view class="card-value">{{vm.terminal.lifeBook.endingId}}</view></view>
            <view wx:if="{{vm.terminal.lifeBook.hasDeath}}" class="card-row"><view class="card-key">死因</view><view class="card-value">{{vm.terminal.lifeBook.deathDetail}}</view></view>
          </view>
        </scroll-view>
        <view wx:if="{{vm.terminalCta}}" class="cta" data-action="{{vm.terminalCta.action}}" bindtap="onTerminalAdvance">{{vm.terminalCta.label}}</view>
      </view>

      <!-- ------------------------------------------------ 转生结果 REBIRTH_RESULT -->
      <view wx:elif="{{vm.isTerminal && vm.terminal && vm.terminal.isRebirthResult}}" class="block">
        <view class="block-title">{{vm.pageStateLabel}}</view>
        <view wx:if="{{vm.terminal.rebirth.runName}}" class="body-text">{{vm.terminal.rebirth.runName}} · 寿 {{vm.terminal.rebirth.finalAge}} · {{vm.terminal.rebirth.finalRealm}}</view>
        <scroll-view class="bounded" scroll-y="true">
          <view class="card">
            <view class="card-title">此世回望</view>
            <view class="card-row"><view class="card-key">经历事件</view><view class="card-value">{{vm.terminal.rebirth.eventsExperienced}}</view></view>
            <view class="card-row"><view class="card-key">结识故人</view><view class="card-value">{{vm.terminal.rebirth.peopleMet}}</view></view>
            <view class="card-row"><view class="card-key">道途成形</view><view class="card-value">{{vm.terminal.rebirth.buildsFormed}}</view></view>
            <view wx:if="{{vm.terminal.rebirth.endingId}}" class="card-row"><view class="card-key">终局</view><view class="card-value">{{vm.terminal.rebirth.endingId}}</view></view>
            <view wx:if="{{vm.terminal.rebirth.deathCause}}" class="card-row"><view class="card-key">死因</view><view class="card-value">{{vm.terminal.rebirth.deathCause}}</view></view>
          </view>
        </scroll-view>
        <view wx:if="{{vm.terminalCta}}" class="cta" data-action="{{vm.terminalCta.action}}" bindtap="onTerminalAdvance">{{vm.terminalCta.label}}</view>
      </view>

      <!-- ------------------------------------------------ 来世 NEXT_LIFE -->
      <view wx:elif="{{vm.isTerminal && vm.terminal && vm.terminal.isNextLife}}" class="block">
        <view class="block-title">{{vm.pageStateLabel}}</view>
        <view wx:if="{{vm.terminal.nextLife.completedRunId}}" class="card-row"><view class="card-key">已结之世</view><view class="card-value">{{vm.terminal.nextLife.completedRunId}}</view></view>
        <view class="body-text">此生已入卷宗。开启下一世会请服务器另起一局新的人生；命格与命（bootstrap 标识）在开启成功之前保持不变。</view>
        <view class="cta" bindtap="onStartNextLife">开启下一世</view>
      </view>

      <!-- 未知/不受支持的服务器投影态：兜底只在这里出现。
           必须是显式否定条件，不能是 wx:else —— 紧邻的 wx:elif 属于终局条件链，
           无条件 wx:else 会在 DESTINY_OFFER / RUN_HOME / EVENT / SPECIAL_NODE
           各自已渲染出内容之后，再额外插入这个兜底块。 -->
      <view wx:if="{{!vm.isOffer && !vm.isHome && !vm.isDecision && !vm.isTerminal}}" class="block">
        <view class="block-title">{{vm.pageStateLabel}}</view>
        <view class="body-text">当前页面状态由服务器投影给出，本页面不为它提供本地操作。</view>
      </view>

      <view wx:if="{{vm.locked}}" class="busy">处理中…</view>
    </block>
  </view>

  <!-- ------------------------------------------------ 生平录 LIFE_ARCHIVE (本地只读侧页) -->
  <view wx:if="{{stage === 'ready' && vm.archiveOpen}}" class="overlay">
    <view class="overlay-head">
      <view class="overlay-title">生平录</view>
      <view class="overlay-close" bindtap="onCloseArchive">关闭</view>
    </view>
    <scroll-view class="overlay-body" scroll-y="true">
      <view class="archive-section">
        <view class="archive-section-title">过往</view>
        <view wx:for="{{vm.archive.history}}" wx:key="entryId" class="archive-row">
          <view class="archive-kind">{{item.kindLabel}}</view>
          <view class="archive-main">
            <view class="archive-title">{{item.title}}</view>
            <view class="archive-summary">{{item.summary}}</view>
            <!-- PLAYUX01 (B2): the live journal now names the option the player took, but only when the
                 save recorded one. A pre-PLAYUX01 save has no choiceId and says so instead of guessing. -->
            <view wx:if="{{item.hasChoice}}" class="archive-summary">当时选择：{{item.choiceLabel}}</view>
            <view wx:else class="archive-summary">此前选择未记录</view>
          </view>
        </view>
      </view>
      <view class="archive-section">
        <view class="archive-section-title">因果</view>
        <view wx:for="{{vm.archive.causes}}" wx:key="publicId" class="archive-row">
          <view class="archive-kind">{{item.level}}</view>
          <view class="archive-main">
            <view class="archive-title">{{item.title}}</view>
            <view class="archive-summary">{{item.summary}}</view>
          </view>
        </view>
      </view>
      <view class="archive-section">
        <view class="archive-section-title">道途</view>
        <view wx:for="{{vm.archive.builds}}" wx:key="buildId" class="archive-row">
          <view class="archive-kind">{{item.dominant ? '主' : '次'}}</view>
          <view class="archive-main">
            <view class="archive-title">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="archive-section">
        <view class="archive-section-title">故人</view>
        <view wx:for="{{vm.archive.people}}" wx:key="npcId" class="archive-row">
          <view class="archive-kind">{{item.knownStatus}}</view>
          <view class="archive-main">
            <view class="archive-title">{{item.displayName}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
