/* UI02 — Tianfu-sim 2.0 preview design tokens.
 *
 * Frozen language: 宣纸 + 墨 + 朱砂 + 极少暗金 + 大量留白 + 克制动画.
 * UI01 froze the language but not HEX / type sizes / spacing / radius — UI02 owns them, and these
 * are the UI02 values. No legacy 1.0 neon dashboard values (#FFD700 glow, #050508 pure-black,
 * #55ff55 / #55ccff / #dd55ff accents) appear anywhere in this page.
 */

page {
  /* 宣纸 */
  --paper: #F5F1E8;
  --paper-sunk: #EDE6D6;
  --paper-raised: #FBF8F1;
  /* 墨 */
  --ink: #1C1A17;
  --ink-soft: #3A3630;
  --ink-muted: #6B655C;
  --ink-faint: #9A9287;
  /* 朱砂 */
  --cinnabar: #A8342A;
  --cinnabar-soft: #C0604F;
  /* 暗金 — restrained, hairlines and one accent only */
  --gold: #8A6B2F;
  --gold-soft: #B08D3F;
  /* rules */
  --rule: #D8D0BE;
  --rule-strong: #C3B79E;

  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 40rpx;
  --space-5: 64rpx;
  --space-6: 96rpx;

  --radius: 4rpx;
  --hairline: 1rpx;

  background-color: var(--paper);
  color: var(--ink);
}

.sheet {
  min-height: 100vh;
  padding: var(--space-4) var(--space-4) var(--space-6);
  background-color: var(--paper);
}

/* ---------- dev preview chrome (not part of the product surface) ---------- */

.dev-chrome {
  padding: var(--space-2) 0 var(--space-4);
  border-bottom: var(--hairline) solid var(--rule);
  margin-bottom: var(--space-4);
}

.dev-note {
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 1rpx;
  margin-bottom: var(--space-2);
}

.dev-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.dev-tab {
  padding: 6rpx var(--space-2);
  font-size: 22rpx;
  color: var(--ink-muted);
  border: var(--hairline) solid var(--rule);
  border-radius: var(--radius);
  background-color: transparent;
}

.dev-tab.is-active {
  color: var(--paper-raised);
  background-color: var(--ink-soft);
  border-color: var(--ink-soft);
}

/* ---------- shared primitives ---------- */

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--ink-faint);
  text-transform: uppercase;
}

.title {
  font-size: 44rpx;
  line-height: 1.3;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.section {
  margin-top: var(--space-5);
}

.section-title {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--ink-muted);
  padding-bottom: var(--space-1);
  border-bottom: var(--hairline) solid var(--rule);
  margin-bottom: var(--space-3);
}

.quiet {
  color: var(--ink-faint);
  font-size: 22rpx;
}

.card {
  padding: var(--space-3) 0;
  border-bottom: var(--hairline) solid var(--rule);
}

.rule {
  height: var(--hairline);
  background-color: var(--rule);
  margin: var(--space-3) 0;
}

.tag {
  display: inline-block;
  padding: 2rpx var(--space-1);
  margin-right: var(--space-1);
  font-size: 20rpx;
  color: var(--ink-muted);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
}

.tag--jin {
  color: var(--gold);
  border-color: var(--gold-soft);
}

.tag--zhu {
  color: var(--cinnabar);
  border-color: var(--cinnabar-soft);
}

/* ---------- RUN_HOME ---------- */

.realm-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.realm-name {
  font-size: 52rpx;
  color: var(--ink);
  letter-spacing: 4rpx;
}

.realm-sub {
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: var(--space-1);
}

.pressure {
  margin-top: var(--space-3);
}

.pressure-track {
  height: 2rpx;
  background-color: var(--rule);
  position: relative;
}

.pressure-fill {
  height: 2rpx;
  background-color: var(--ink-soft);
}

.pressure-fill.is-pressing {
  background-color: var(--cinnabar);
}

.pressure-legend {
  display: flex;
  justify-content: space-between;
  margin-top: var(--space-1);
}

.stat-row {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.stat {
  min-width: 120rpx;
}

.stat-label {
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
}

.stat-value {
  font-size: 28rpx;
  color: var(--ink-soft);
  margin-top: 2rpx;
}

.build-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-2) 0;
}

.build-line.is-dominant .build-name {
  color: var(--ink);
}

.build-name {
  font-size: 26rpx;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
}

.build-stage {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.build-line.is-dominant .build-stage {
  color: var(--gold);
}

.person {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-2) 0;
  border-bottom: var(--hairline) solid var(--rule);
}

.person-name {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.person-meta {
  font-size: 20rpx;
  color: var(--ink-faint);
  text-align: right;
}

.actions-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.action {
  flex: 1 1 calc(50% - var(--space-2));
  padding: var(--space-3) var(--space-2);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
  background-color: var(--paper-raised);
  text-align: center;
  transition: opacity 160ms ease;
}

.action:active {
  opacity: 0.72;
}

.action-label {
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: var(--ink);
}

.action.is-disabled {
  opacity: 0.4;
  border-color: var(--rule);
}

.special-entry {
  margin-top: var(--space-3);
  padding: var(--space-3);
  border: var(--hairline) solid var(--gold-soft);
  border-radius: var(--radius);
  background-color: var(--paper-raised);
  text-align: center;
}

.special-entry.is-blocked {
  border-color: var(--rule);
  border-style: dashed;
  opacity: 0.55;
}

.special-label {
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: var(--gold);
}

.special-target {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: var(--space-1);
}

.special-reason {
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-top: var(--space-1);
}

/* ---------- EVENT / SPECIAL_NODE ---------- */

.decision {
  padding-top: var(--space-3);
}

.decision-locked {
  font-size: 20rpx;
  color: var(--cinnabar);
  letter-spacing: 2rpx;
  padding: var(--space-1) var(--space-2);
  border: var(--hairline) solid var(--cinnabar-soft);
  border-radius: var(--radius);
  display: inline-block;
}

.scene-body {
  margin-top: var(--space-3);
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--ink-soft);
}

.participants {
  margin-top: var(--space-3);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.option {
  margin-top: var(--space-2);
  padding: var(--space-3);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
  background-color: var(--paper-raised);
}

.option-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.option-label {
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.option-risk {
  font-size: 22rpx;
  color: var(--ink-muted);
}

.option-risk.is-dangerous {
  color: var(--cinnabar-soft);
}

.option-risk.is-lethal {
  color: var(--cinnabar);
}

.option-reasons {
  margin-top: var(--space-1);
  font-size: 20rpx;
  color: var(--ink-faint);
}

.fatal-flag {
  margin-top: var(--space-1);
  font-size: 20rpx;
  color: var(--cinnabar);
}

/* ---------- LIFE_ARCHIVE ---------- */

.archive-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.entry {
  padding: var(--space-2) 0;
  border-bottom: var(--hairline) solid var(--rule);
}

.entry-key {
  font-size: 22rpx;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
}

.entry-title {
  font-size: 28rpx;
  color: var(--ink-soft);
  margin-top: 2rpx;
}

.entry-summary {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 2rpx;
}

.archive-footnote {
  margin-top: var(--space-5);
  font-size: 20rpx;
  color: var(--ink-faint);
  line-height: 1.8;
  border-top: var(--hairline) solid var(--rule);
  padding-top: var(--space-3);
}

/* ---------- capability-gated placeholder ---------- */

.gated-strip {
  margin-top: var(--space-4);
  padding: var(--space-2) 0;
  border-top: var(--hairline) solid var(--rule);
}

.gated-item {
  font-size: 20rpx;
  color: var(--ink-faint);
  padding: 2rpx 0;
}
