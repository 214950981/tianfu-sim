/* UI02R1 — Tianfu-sim 2.0 preview design tokens + one-screen responsive layout contract.
 *
 * Frozen language (UI01/UI02, unchanged): 宣纸 + 墨 + 朱砂 + 极少暗金 + 大量留白 + 克制动画.
 * UI02 owns HEX / type sizes / spacing / radius; these stay the UI02 values. No legacy 1.0 neon
 * dashboard values (#FFD700 glow, #050508 pure-black, #55ff55 / #55ccff / #dd55ff accents) appear
 * anywhere in this page.
 *
 * UI02R1 adds the viewport contract. Supported baseline: portrait, windowWidth >= 320 CSS px and
 * windowHeight >= 500 CSS px (WeChat content viewport, not a marketing device model). RUN_HOME /
 * EVENT / SPECIAL_NODE are constrained to exactly one viewport; LIFE_ARCHIVE scrolls only inside its
 * own viewport. The layout tokens below are the single source of truth consumed by
 * tools/ui02r1-layout-audit.mjs, which re-derives the first-screen budget from this file.
 *
 * rpx is used for horizontal scale and typography; vertical space is managed with viewport units,
 * flex and safe-area insets. Nothing here shrinks text or touch targets to fake a one-screen fit:
 * --touch-min / --cta-h / --dock-row-h never drop below 104rpx, which is ~44 CSS px at windowWidth 320.
 *
 * UI02R2 keeps every structural contract above and refines presentation only: rhythm tokens gain
 * breathing room, the breakthrough CTA becomes the single solid-ink primary control, the four core
 * actions stay uniform outline secondaries, attention tags become chips, and structural enum ids are
 * shown through the Chinese presentation label vocabulary in v2-preview.js (unknown ids fall back
 * verbatim). The frozen design language and all UI02 HEX values are unchanged; --radius-card is an
 * additional, slightly rounder corner reserved for interactive cards and buttons.
 *
 * WXSS compatibility (checked by tools/wxss-compat-audit.mjs):
 *  - No universal `*` selector. The DevTools WXSS compiler rejects the `*` token outright, and there is
 *    no universal reset here; every box that has a definite size AND padding/border declares
 *    `box-sizing: border-box` itself, which is what keeps the one-screen budget arithmetic true.
 *  - No attribute selectors (`[...]`) and no parameterised pseudo-classes/pseudo-elements
 *    (the two documented WXSS exceptions).
 *  - Selectors stay inside page / simple element / simple class / compound class / descendant-class,
 *    plus the parameterless `:active` pseudo-class.
 *  - At-rules limited to @media; media conditions limited to (min|max)-(width|height) in px.
 */

page {
  /* 宣纸 */
  --paper: #F5F1E8;
  --paper-sunk: #EDE6D6;
  --paper-raised: #FBF8F1;
  /* 墨 */
  --ink: #1C1A17;
  --ink-soft: #3A3630;
  --ink-muted: #6B655C;
  --ink-faint: #9A9287;
  /* 朱砂 */
  --cinnabar: #A8342A;
  --cinnabar-soft: #C0604F;
  /* 暗金 — restrained, hairlines and one accent only */
  --gold: #8A6B2F;
  --gold-soft: #B08D3F;
  /* rules */
  --rule: #D8D0BE;
  --rule-strong: #C3B79E;
  /* scrims */
  --scrim: rgba(28, 26, 23, 0.42);

  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 40rpx;
  --space-5: 64rpx;
  --space-6: 96rpx;

  --radius: 4rpx;
  --radius-card: 8rpx;
  --hairline: 1rpx;

  /* ---------- UI02R1 baseline viewport ---------- */
  --baseline-w: 320px;
  --baseline-h: 500px;

  /* ---------- UI02R1 vertical budget tokens ----------
     Every token below is consumed by a real rule. tools/ui02r1-layout-audit.mjs re-reads them and
     proves the worst-case first-screen stack still fits the supported baseline.
     UI02R2 raises the non-interactive rhythm tokens (vitals / attention rows / section gaps) for
     breathing room; the interaction floors (--touch-min / --cta-h / --dock-row-h) are untouched. */
  --screen-pad-x: 28rpx;
  --screen-pad-top: 12rpx;
  --hero-name-lh: 84rpx;
  --hero-meta-h: 40rpx;
  --life-h: 56rpx;
  --vitals-h: 84rpx;
  --attn-head-h: 40rpx;
  --attn-slot-h: 70rpx;
  --attn-note-pad: 8rpx;
  --dock-pad-top: 16rpx;
  --dock-pad-bottom: 12rpx;
  --dock-note-h: 56rpx;
  --dock-gap: 12rpx;
  --dock-col-w: calc(50% - 6rpx);

  /* Interaction floors. 104rpx == 44.37 CSS px at windowWidth 320 (104 * 320 / 750). */
  --touch-min: 104rpx;
  --cta-h: 104rpx;
  --dock-row-h: 104rpx;

  /* Horizontal room reserved so the floating dev trigger never covers the realm name. */
  --dev-reserve-x: 108rpx;
  --dev-trigger-top: 10rpx;

  background-color: var(--paper);
  color: var(--ink);
  height: 100%;
  overflow: hidden;
}

/* ---------- viewport matrix: width bands ----------
   compact-xs 320 | compact 360 / classic 375 / modern 390 | large 414 / large-tall 430 */

@media (min-width: 340px) {
  page {
    --screen-pad-x: 32rpx;
    --dev-reserve-x: 116rpx;
  }
}

@media (min-width: 400px) {
  page {
    --screen-pad-x: 36rpx;
  }
}

/* ---------- viewport matrix: height bands ----------
   320x500 -> baseline tokens | 360x560 -> h560 | 375x603 -> h600 | 390x750 -> h750 | 414x820 / 430x850 -> h820 */

@media (min-height: 560px) {
  page {
    --screen-pad-top: 14rpx;
    --hero-name-lh: 88rpx;
    --vitals-h: 88rpx;
    --attn-slot-h: 74rpx;
  }
}

@media (min-height: 600px) {
  page {
    --screen-pad-top: 16rpx;
    --hero-name-lh: 92rpx;
    --vitals-h: 90rpx;
    --attn-head-h: 40rpx;
    --attn-slot-h: 76rpx;
    --dock-pad-top: 16rpx;
  }
}

@media (min-height: 750px) {
  page {
    --screen-pad-top: 20rpx;
    --hero-name-lh: 100rpx;
    --hero-meta-h: 44rpx;
    --life-h: 60rpx;
    --vitals-h: 96rpx;
    --attn-head-h: 44rpx;
    --attn-slot-h: 82rpx;
    --dock-pad-top: 20rpx;
    --dock-pad-bottom: 16rpx;
  }
}

@media (min-height: 820px) {
  page {
    --hero-name-lh: 108rpx;
    --attn-slot-h: 88rpx;
    --cta-h: 112rpx;
    --dock-row-h: 112rpx;
  }
}

/* ---------- screen shell: constrained viewport, no page-level document scroll ---------- */

.screen {
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  padding: var(--screen-pad-top) var(--screen-pad-x) 0;
  background-color: var(--paper);
}

.surface {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}

.notice {
  padding: var(--space-3) 0;
  border-bottom: var(--hairline) solid var(--rule);
}

/* ---------- preview data load failure ----------
   A dev diagnostic that must never be a silent blank page. It is bounded by design: one line per
   field, capped by the page's own sanitizer, and it renders no fixture content or raw state. */

.failure {
  margin-top: var(--space-3);
  padding: var(--space-3);
  border: var(--hairline) solid var(--cinnabar-soft);
  border-radius: var(--radius-card);
  background-color: var(--paper-raised);
}

.failure-title {
  font-size: 28rpx;
  color: var(--cinnabar);
  letter-spacing: 2rpx;
  margin-bottom: var(--space-1);
}

.failure-row {
  display: flex;
  align-items: baseline;
  margin-top: var(--space-1);
  min-width: 0;
}

.failure-key {
  flex: 0 0 auto;
  width: 80rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
}

.failure-value {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 22rpx;
  color: var(--ink-soft);
  word-break: break-all;
}

.failure-hint {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: var(--hairline) solid var(--rule);
  font-size: 20rpx;
  color: var(--ink-muted);
  line-height: 1.7;
  word-break: break-all;
}

/* ---------- shared primitives ---------- */

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--ink-faint);
}

.section {
  margin-top: var(--space-4);
}

.section-title {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--ink-muted);
  padding-bottom: var(--space-1);
  border-bottom: var(--hairline) solid var(--rule);
  margin-bottom: var(--space-2);
}

.quiet {
  color: var(--ink-faint);
  font-size: 22rpx;
}

.tag {
  display: inline-block;
  padding: 2rpx var(--space-1);
  margin-right: var(--space-1);
  font-size: 20rpx;
  color: var(--ink-muted);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
  white-space: nowrap;
}

.tag--jin {
  color: var(--gold);
  border-color: var(--gold-soft);
}

/* ---------- RUN_HOME ---------- */

.home-body {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}

.hero {
  flex: 0 0 auto;
  min-width: 0;
}

.hero-name {
  font-size: 52rpx;
  font-weight: 600;
  line-height: var(--hero-name-lh);
  height: var(--hero-name-lh);
  letter-spacing: 6rpx;
  color: var(--ink);
  padding-right: var(--dev-reserve-x);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-meta {
  display: flex;
  align-items: baseline;
  height: var(--hero-meta-h);
  min-width: 0;
  padding-right: var(--dev-reserve-x);
}

.hero-run {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ink-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* The realm order is the one restrained dark-gold accent in the hero: order 0 renders 未入修行. */
.hero-realm {
  flex: 0 0 auto;
  margin-left: var(--space-2);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--gold);
  white-space: nowrap;
}

.life {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: var(--life-h);
  margin-top: var(--space-1);
}

.life-track {
  height: 3rpx;
  background-color: var(--rule);
}

.life-fill {
  height: 3rpx;
  background-color: var(--ink-soft);
}

.life-fill.is-pressing {
  background-color: var(--cinnabar);
}

.life-legend {
  display: flex;
  justify-content: space-between;
  margin-top: var(--space-1);
  min-width: 0;
}

.life-legend .quiet {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.quiet.is-pressing {
  color: var(--cinnabar);
}

/* Core cultivation status: one strip, three equal columns separated by hairline dividers. */
.vitals {
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  flex: 0 0 auto;
  height: var(--vitals-h);
  margin-top: var(--space-2);
  border-top: var(--hairline) solid var(--rule);
  border-bottom: var(--hairline) solid var(--rule);
}

.vital {
  flex: 1 1 0%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 var(--space-1);
}

.vital--lead {
  padding-left: 0;
}

.vital--rule {
  border-right: var(--hairline) solid var(--rule);
  padding-right: var(--space-2);
}

.vital--tail {
  padding-right: 0;
}

.vital-label {
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.vital-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.attention {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
  margin-top: var(--space-2);
}

.attention-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
  height: var(--attn-head-h);
  min-width: 0;
}

.attention-title-group {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* Small dark-gold square: the single accent that marks the "current priorities" panel header. */
.attention-mark {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin-right: var(--space-1);
  background-color: var(--gold);
}

.attention-title {
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--ink-soft);
  white-space: nowrap;
}

.attention-hint {
  font-size: 20rpx;
  color: var(--ink-faint);
  white-space: nowrap;
}

/* Bounded internal scroll: at supported viewports the three summary rows fit without scrolling, and
   below the supported baseline the region degrades into internal scroll instead of hidden clipping. */
.attention-scroll {
  box-sizing: border-box;
  flex: 1 1 auto;
  min-height: 0;
  padding-top: var(--attn-note-pad);
}

.attn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: var(--attn-slot-h);
  min-width: 0;
  border-bottom: var(--hairline) solid var(--rule);
}

.attn:active {
  opacity: 0.72;
}

/* Attention tags read as small chips, not a fixed-width table column. */
.attn-tag {
  flex: 0 0 auto;
  margin-right: var(--space-2);
  padding: 3rpx 12rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-muted);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
  white-space: nowrap;
}

.attn-value {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink-soft);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.attn-enter {
  flex: 0 0 auto;
  margin-left: var(--space-1);
  font-size: 26rpx;
  color: var(--gold-soft);
}

/* ---------- action dock ----------
   Hierarchy: the breakthrough CTA is the single primary control (solid ink, paper text, gold target);
   the four core actions are a coherent group of secondary outline buttons beneath it. */

.dock {
  flex: 0 0 auto;
  padding-top: var(--dock-pad-top);
  padding-bottom: var(--dock-pad-bottom);
  padding-bottom: calc(var(--dock-pad-bottom) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--dock-pad-bottom) + env(safe-area-inset-bottom, 0px));
  border-top: var(--hairline) solid var(--rule-strong);
}

.cta {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--cta-h);
  padding: 0 var(--space-3);
  border: 2rpx solid var(--ink);
  border-radius: var(--radius-card);
  background-color: var(--ink);
  margin-bottom: var(--dock-gap);
}

.cta:active {
  opacity: 0.8;
}

.cta-label {
  flex: 0 0 auto;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  color: var(--paper);
  white-space: nowrap;
}

.cta-target {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: var(--space-2);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--gold-soft);
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dock-note {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  height: var(--dock-note-h);
  margin-bottom: var(--dock-gap);
  padding: 0 var(--space-2);
  font-size: 20rpx;
  color: var(--ink-faint);
  border: var(--hairline) dashed var(--rule-strong);
  border-radius: var(--radius-card);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dock-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--dock-gap);
}

.action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 var(--dock-col-w);
  min-height: var(--dock-row-h);
  padding: var(--space-2);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius-card);
  background-color: var(--paper-raised);
  transition: opacity 160ms ease;
}

.action:active {
  opacity: 0.72;
}

.action-label {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.action.is-disabled {
  opacity: 0.4;
  border-color: var(--rule);
}

/* ---------- EVENT / SPECIAL_NODE: fixed full-screen decision container ---------- */

.decision-head {
  flex: 0 0 auto;
  min-width: 0;
  padding-bottom: var(--space-2);
}

.decision-title {
  margin-top: var(--space-1);
  font-size: 40rpx;
  line-height: 1.35;
  color: var(--ink);
  letter-spacing: 2rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.decision-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin-top: var(--space-1);
  overflow: hidden;
}

.decision-locked {
  display: inline-block;
  margin-top: var(--space-2);
  font-size: 20rpx;
  color: var(--cinnabar);
  letter-spacing: 2rpx;
  padding: 2rpx var(--space-2);
  border: var(--hairline) solid var(--cinnabar-soft);
  border-radius: var(--radius);
}

/* Bounded internal scroll for long narrative and many options; the headline stays pinned. */
.decision-viewport {
  box-sizing: border-box;
  flex: 1 1 auto;
  min-height: 0;
  padding-bottom: var(--dock-pad-bottom);
  padding-bottom: calc(var(--dock-pad-bottom) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--dock-pad-bottom) + env(safe-area-inset-bottom, 0px));
}

.scene-body {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  word-break: break-all;
}

.option {
  margin-top: var(--space-2);
  padding: var(--space-3);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius-card);
  background-color: var(--paper-raised);
}

.option-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-width: 0;
}

.option-label {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* Risk tier reads as a chip: the mapped tier label plus the tier colour the page already carried. */
.option-risk {
  flex: 0 0 auto;
  margin-left: var(--space-2);
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-muted);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
  white-space: nowrap;
}

.option-risk.is-dangerous {
  color: var(--cinnabar-soft);
}

.option-risk.is-lethal {
  color: var(--cinnabar);
}

.option-reasons {
  margin-top: var(--space-1);
  font-size: 20rpx;
  color: var(--ink-faint);
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.fatal-flag {
  margin-top: var(--space-1);
  font-size: 20rpx;
  color: var(--cinnabar);
}

/* ---------- LIFE_ARCHIVE: intentionally scrollable read-only history ---------- */

.archive-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex: 0 0 auto;
  min-width: 0;
  padding-bottom: var(--space-2);
}

.archive-title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 44rpx;
  line-height: 1.3;
  color: var(--ink);
  letter-spacing: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.archive-viewport {
  box-sizing: border-box;
  flex: 1 1 auto;
  min-height: 0;
  padding-bottom: var(--space-4);
  padding-bottom: calc(var(--space-4) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
}

.entry {
  padding: var(--space-2) 0;
  border-bottom: var(--hairline) solid var(--rule);
}

.entry-key {
  font-size: 22rpx;
  color: var(--ink-faint);
  letter-spacing: 2rpx;
  word-break: break-all;
}

.entry-title {
  font-size: 28rpx;
  color: var(--ink-soft);
  margin-top: 2rpx;
  word-break: break-all;
}

.entry-summary {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 2rpx;
  word-break: break-all;
}

.build-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-2) 0;
  min-width: 0;
}

.build-line.is-dominant .build-name {
  color: var(--ink);
}

.build-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.build-stage {
  flex: 0 0 auto;
  margin-left: var(--space-2);
  font-size: 22rpx;
  color: var(--ink-faint);
  max-width: 40%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.build-line.is-dominant .build-stage {
  color: var(--gold);
}

.person {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-2) 0;
  border-bottom: var(--hairline) solid var(--rule);
  min-width: 0;
}

.person-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink-soft);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.person-meta {
  flex: 0 0 auto;
  margin-left: var(--space-2);
  max-width: 46%;
  font-size: 20rpx;
  color: var(--ink-faint);
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.footnote {
  margin-top: var(--space-4);
  font-size: 20rpx;
  color: var(--ink-faint);
  line-height: 1.8;
  word-break: break-all;
  border-top: var(--hairline) solid var(--rule);
  padding-top: var(--space-2);
}

/* ---------- dev layer: fixed overlay, zero product layout height ---------- */

.dev-trigger {
  box-sizing: border-box;
  position: fixed;
  z-index: 30;
  top: var(--dev-trigger-top);
  right: var(--screen-pad-x);
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--touch-min);
  min-height: var(--touch-min);
  padding: 0 var(--space-2);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius-card);
  background-color: var(--paper-raised);
}

.dev-trigger.is-open {
  border-color: var(--ink-soft);
}

.dev-trigger-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--ink-muted);
  white-space: nowrap;
}

.dev-scrim {
  position: fixed;
  z-index: 40;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: var(--scrim);
}

.dev-panel {
  position: fixed;
  z-index: 41;
  top: 8vh;
  right: var(--screen-pad-x);
  bottom: 8vh;
  left: var(--screen-pad-x);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
  background-color: var(--paper-raised);
}

.dev-scroll {
  box-sizing: border-box;
  flex: 1 1 auto;
  min-height: 0;
  padding: var(--space-3);
}

.dev-note {
  font-size: 20rpx;
  color: var(--ink-faint);
  letter-spacing: 1rpx;
  line-height: 1.7;
}

.dev-block {
  margin-top: var(--space-3);
  padding-top: var(--space-2);
  border-top: var(--hairline) solid var(--rule);
}

.dev-block-title {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--ink-muted);
  margin-bottom: var(--space-1);
}

.dev-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.dev-tab {
  box-sizing: border-box;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--space-2);
  font-size: 22rpx;
  color: var(--ink-muted);
  border: var(--hairline) solid var(--rule);
  border-radius: var(--radius);
  background-color: transparent;
}

.dev-tab.is-active {
  color: var(--paper-raised);
  background-color: var(--ink-soft);
  border-color: var(--ink-soft);
}

.dev-line {
  font-size: 20rpx;
  color: var(--ink-faint);
  line-height: 1.8;
  word-break: break-all;
}

.dev-action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  margin-top: var(--space-2);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
  background-color: var(--paper);
}

.dev-action-label {
  font-size: 22rpx;
  color: var(--ink-soft);
  letter-spacing: 2rpx;
}

/* ---------- read-only detail drawers ---------- */

.drawer-scrim {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: var(--scrim);
}

.drawer {
  position: fixed;
  z-index: 51;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-top: var(--hairline) solid var(--rule-strong);
  background-color: var(--paper-raised);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
  min-width: 0;
  padding: var(--space-2) var(--screen-pad-x) 0;
}

.drawer-title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.drawer-close {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-height: 72rpx;
  min-width: 96rpx;
  margin-left: var(--space-2);
  border: var(--hairline) solid var(--rule-strong);
  border-radius: var(--radius);
}

.drawer-close-label {
  font-size: 22rpx;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
}

.drawer-note {
  flex: 0 0 auto;
  padding: var(--space-1) var(--screen-pad-x) 0;
  font-size: 20rpx;
  color: var(--ink-faint);
  line-height: 1.6;
}

/* Explicit bounded viewport so the drawer body always scrolls internally and never grows the sheet. */
.drawer-scroll {
  box-sizing: border-box;
  flex: 1 1 auto;
  min-height: 0;
  height: 46vh;
  padding: var(--space-2) var(--screen-pad-x) var(--space-3);
}

.drawer-empty {
  font-size: 22rpx;
  color: var(--ink-faint);
  padding: var(--space-2) 0;
}

.drawer-row {
  padding: var(--space-2) 0;
  border-bottom: var(--hairline) solid var(--rule);
  min-width: 0;
}

.drawer-row-title {
  font-size: 26rpx;
  color: var(--ink-soft);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.drawer-row-meta {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
