<!-- UI02R1 dev preview — one-screen operational surface.

     Product surface (RUN_HOME / EVENT / SPECIAL_NODE / LIFE_ARCHIVE) lives inside .surface, which is
     height-constrained by .screen (100vh) and never grows the document: RUN_HOME / EVENT /
     SPECIAL_NODE have no page-level vertical scroll, LIFE_ARCHIVE scrolls only inside its own
     viewport, and long regions scroll inside bounded scroll-view containers.

     The dev layer (.dev-trigger / .dev-panel) and the read-only detail drawers (.drawer) are fixed
     overlays. They carry zero product layout height, so switching views or reading diagnostics never
     changes how much of the product surface is visible.

     Everything rendered here is already-public server projection. No value is computed locally. -->
<view class="screen">

  <view class="surface">

    <!-- Preview data could not be loaded. Explicit, bounded diagnostics instead of a silent blank or
         a misleading "file is missing" message: stage / error name / sanitized detail / module
         specifier / CLI hint. No fixture content and no raw state is ever rendered here. -->
    <view wx:if="{{failure !== null}}" class="failure">
      <view class="failure-title">预览数据加载失败</view>
      <view class="failure-row">
        <view class="failure-key">阶段</view>
        <view class="failure-value">{{failure.stage}}</view>
      </view>
      <view class="failure-row">
        <view class="failure-key">代码</view>
        <view class="failure-value">{{failure.code}}</view>
      </view>
      <view class="failure-row" wx:if="{{failure.detail !== ''}}">
        <view class="failure-key">详情</view>
        <view class="failure-value">{{failure.detail}}</view>
      </view>
      <view class="failure-row">
        <view class="failure-key">模块</view>
        <view class="failure-value">{{failure.specifier}}</view>
      </view>
      <view class="failure-hint">{{failure.hint}}</view>
    </view>

    <block wx:if="{{failure === null && vm !== null}}">

      <!-- ===================== RUN_HOME ===================== -->
      <view wx:if="{{vm.kind === 'RUN_HOME'}}" class="page page--home">

        <view class="home-body">

          <!-- 1. identity and lifespan -->
          <view class="hero">
            <view class="hero-name">{{vm.runHome.realmName}}</view>
            <view class="hero-meta">
              <view class="hero-run">{{vm.runHome.runName}}</view>
              <view class="hero-realm">第 {{vm.runHome.realmOrder}} 境</view>
            </view>
            <view class="life">
              <view class="life-track">
                <view class="life-fill {{vm.runHome.lifespan.pressing ? 'is-pressing' : ''}}"
                      style="width: {{vm.runHome.lifespan.percent}}%;"></view>
              </view>
              <view class="life-legend">
                <view class="quiet">寿元 {{vm.runHome.lifespan.age}} / {{vm.runHome.lifespan.maxAge}}</view>
                <view class="quiet {{vm.runHome.lifespan.pressing ? 'is-pressing' : ''}}">余 {{vm.runHome.lifespan.remaining}}</view>
              </view>
            </view>
          </view>

          <!-- 2. core cultivation status -->
          <view class="vitals">
            <view class="vital">
              <view class="vital-label">修为</view>
              <view class="vital-value">{{vm.runHome.cultivation}} / 10000</view>
            </view>
            <view class="vital">
              <view class="vital-label">道基</view>
              <view class="vital-value">{{vm.runHome.foundation}} / 10000</view>
            </view>
            <view class="vital">
              <view class="vital-label">灵石</view>
              <view class="vital-value">{{vm.runHome.possessions}}</view>
            </view>
          </view>

          <!-- 3. at most three public attention summaries; full lists live in read-only drawers -->
          <view class="attention">
            <view class="attention-head">
              <view class="attention-title">此刻值得关注</view>
              <view class="attention-hint">点开查看只读详情</view>
            </view>
            <scroll-view class="attention-scroll" scroll-y>
              <view wx:for="{{vm.runHome.attentions}}" wx:key="key" class="attn"
                    data-drawer="{{item.drawer}}" bindtap="onOpenDrawer">
                <view class="attn-tag">{{item.tag}}</view>
                <view class="attn-value">{{item.value}}</view>
                <view class="attn-enter">›</view>
              </view>
              <view class="attn" data-drawer="conditions" bindtap="onOpenDrawer">
                <view class="attn-tag">条件</view>
                <view class="attn-value">{{vm.runHome.conditionSummary}}</view>
                <view class="attn-enter">›</view>
              </view>
            </scroll-view>
          </view>

        </view>

        <!-- 4. bottom action dock: breakthrough CTA only when publicly available, then four actions -->
        <view class="dock">
          <view wx:if="{{vm.runHome.breakthrough.enabled}}" class="cta"
                data-intent="{{vm.runHome.breakthrough.intentId}}" bindtap="onIntent">
            <view class="cta-label">{{vm.runHome.breakthrough.label}}</view>
            <view class="cta-target" wx:if="{{vm.runHome.breakthrough.targetName !== ''}}">目标 {{vm.runHome.breakthrough.targetName}}</view>
          </view>
          <view wx:elif="{{vm.runHome.breakthrough.note !== ''}}" class="dock-note">
            {{vm.runHome.breakthrough.note}}
          </view>
          <view class="dock-grid">
            <view wx:for="{{vm.runHome.actions}}" wx:key="intentId"
                  class="action {{item.enabled ? '' : 'is-disabled'}}"
                  data-intent="{{item.intentId}}" bindtap="onIntent">
              <view class="action-label">{{item.label}}</view>
            </view>
          </view>
        </view>

      </view>

      <!-- ===================== EVENT / SPECIAL_NODE ===================== -->
      <view wx:if="{{vm.kind === 'EVENT' || vm.kind === 'SPECIAL_NODE'}}" class="page page--decision">

        <view class="decision-head">
          <view class="eyebrow">{{vm.kind === 'SPECIAL_NODE' ? '特殊节点' : '事件'}}</view>
          <view class="decision-title">{{vm.decision.headline}}</view>
          <view class="decision-tags" wx:if="{{vm.decision.participants.length > 0}}">
            <view wx:for="{{vm.decision.participants}}" wx:key="slot" class="tag">{{item.slot}} · {{item.name}}</view>
          </view>
          <view class="decision-locked" wx:if="{{vm.decision.locked}}">未落定 · 普通返回已锁定</view>
        </view>

        <scroll-view class="decision-viewport" scroll-y>
          <view class="scene-body">{{vm.decision.bodyKey}}</view>
          <view class="option" wx:for="{{vm.decision.options}}" wx:key="optionId">
            <view class="option-head">
              <view class="option-label">{{item.label}}</view>
              <view wx:if="{{item.hasRisk}}" class="option-risk {{item.tierClass}}">{{item.tier}}</view>
            </view>
            <view class="option-reasons" wx:if="{{item.hasRisk && item.reasons.length > 0}}">{{item.reasons}}</view>
            <view class="fatal-flag" wx:if="{{item.canBeFatal}}">此选项可能致命</view>
          </view>
        </scroll-view>

      </view>

      <!-- ===================== LIFE_ARCHIVE ===================== -->
      <view wx:if="{{vm.kind === 'LIFE_ARCHIVE'}}" class="page page--archive">

        <view class="archive-head">
          <view class="archive-title">{{vm.archive.runName}}</view>
          <view class="tag tag--jin">只读</view>
        </view>

        <scroll-view class="archive-viewport" scroll-y>

          <view class="section" wx:if="{{vm.archive.hasDeath}}">
            <view class="section-title">终局</view>
            <view class="entry">
              <view class="entry-key">享年 / 境界</view>
              <view class="entry-title">{{vm.archive.deathAge}} 岁 · {{vm.archive.deathRealm}}</view>
              <view class="entry-summary">直接缘由 · {{vm.archive.deathCause}}</view>
              <view class="entry-summary" wx:if="{{vm.archive.wasWarned}}">事前已有警示</view>
            </view>
          </view>

          <view class="section">
            <view class="section-title">公开因果</view>
            <view class="quiet" wx:if="{{vm.archive.causes.length === 0}}">无</view>
            <view wx:for="{{vm.archive.causes}}" wx:key="publicId" class="entry">
              <view class="tag {{item.level === 'explicit' ? 'tag--jin' : ''}}">{{item.label}}</view>
            </view>
          </view>

          <view class="section">
            <view class="section-title">已公开往事</view>
            <view class="quiet" wx:if="{{vm.archive.entries.length === 0}}">无</view>
            <view wx:for="{{vm.archive.entries}}" wx:key="entryId" class="entry">
              <view class="entry-key">{{item.kind}}</view>
              <view class="entry-title">{{item.title}}</view>
              <view class="entry-summary">{{item.summary}}</view>
            </view>
          </view>

          <view class="section">
            <view class="section-title">道途印记</view>
            <view wx:for="{{vm.archive.builds}}" wx:key="buildId" class="build-line {{item.dominant ? 'is-dominant' : ''}}">
              <view class="build-name">{{item.name}}</view>
              <view class="build-stage">{{item.stage}}</view>
            </view>
          </view>

          <view class="section">
            <view class="section-title">相识之人</view>
            <view wx:for="{{vm.archive.people}}" wx:key="npcId" class="person">
              <view class="person-name">{{item.name}}</view>
              <view class="person-meta">{{item.roles}}</view>
            </view>
          </view>

          <view class="footnote">
            命书为只读侧页，仅聚合服务端已公开的历史、明确或暗示的因果、相识之人与公开道途印记。
            隐藏因果不会以占位、数量或可推断元数据的形式出现。
          </view>

        </scroll-view>

      </view>

    </block>
  </view>

  <!-- ===================== dev layer: fixed overlay, zero product layout height ===================== -->

  <view class="dev-trigger {{devOpen ? 'is-open' : ''}}" bindtap="onToggleDev">
    <view class="dev-trigger-label">{{devOpen ? '收起' : '调试'}}</view>
  </view>

  <view class="dev-scrim" wx:if="{{devOpen}}" bindtap="onCloseDev"></view>

  <view class="dev-panel" wx:if="{{devOpen}}">
    <scroll-view class="dev-scroll" scroll-y>
      <view class="dev-note">UI02R1 内景预览 · 开发路由 · 非默认页 · 生产接线未完成</view>

      <view class="dev-block">
        <view class="dev-block-title">视图</view>
        <view class="dev-tabs">
          <view wx:for="{{tabs}}" wx:key="key"
                class="dev-tab {{activeKey === item.key ? 'is-active' : ''}}"
                data-key="{{item.key}}" bindtap="onSelectTab">{{item.label}}</view>
        </view>
      </view>

      <view class="dev-block">
        <view class="dev-block-title">交互诊断</view>
        <view class="dev-line">最近意图 · {{lastIntent}}</view>
        <block wx:if="{{vm !== null && vm.decision}}">
          <view class="dev-line">交互状态 · {{vm.decision.state}}</view>
          <view class="dev-line">决策标识 · {{vm.decision.decisionId}}</view>
          <view class="dev-line" wx:if="{{vm.decision.locked}}">锁定说明 · 服务端页面状态未落定，普通返回不可用</view>
          <view class="dev-action" bindtap="onBlockedBack">
            <view class="dev-action-label">尝试普通返回</view>
          </view>
        </block>
      </view>

      <view class="dev-block">
        <view class="dev-block-title">能力入口</view>
        <view class="dev-line" wx:if="{{failure !== null}}">预览数据不可用 · 能力入口未知</view>
        <block wx:else>
          <view class="dev-line" wx:if="{{vm.gatedEntries.length === 0}}">全部可用</view>
          <view class="dev-line" wx:for="{{vm.gatedEntries}}" wx:key="*this">已隐藏 · {{item}}</view>
        </block>
      </view>

      <view class="dev-block">
        <view class="dev-block-title">一屏策略</view>
        <view class="dev-line">RUN_HOME / EVENT / SPECIAL_NODE 无页面级纵向滚动。</view>
        <view class="dev-line">开发层与详情抽屉为悬浮覆盖，不占产品布局高度。</view>
        <view class="dev-line">产品内容缩放由 wxss 的视口矩阵断点控制，不靠缩小字号或点击区。</view>
      </view>

      <view class="dev-note">切换视图会收起本面板，便于直接观察产品一屏效果。</view>
    </scroll-view>
  </view>

  <!-- ===================== read-only detail drawers (already-public data only) ===================== -->

  <view class="drawer-scrim" wx:if="{{drawer !== null}}" bindtap="onCloseDrawer"></view>

  <view class="drawer" wx:if="{{drawer !== null}}">
    <view class="drawer-head">
      <view class="drawer-title">{{drawer.title}}</view>
      <view class="drawer-close" bindtap="onCloseDrawer">
        <view class="drawer-close-label">收起</view>
      </view>
    </view>
    <view class="drawer-note">{{drawer.note}}</view>
    <scroll-view class="drawer-scroll" scroll-y>
      <view class="drawer-empty" wx:if="{{drawer.rows.length === 0}}">无</view>
      <view wx:for="{{drawer.rows}}" wx:key="key" class="drawer-row">
        <view class="drawer-row-title">{{item.title}}</view>
        <view class="drawer-row-meta" wx:if="{{item.meta !== ''}}">{{item.meta}}</view>
      </view>
    </scroll-view>
  </view>

</view>
